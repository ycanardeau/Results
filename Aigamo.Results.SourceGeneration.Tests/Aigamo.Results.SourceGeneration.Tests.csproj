<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Reference the generator as a normal assembly (not an analyzer) so the tests
       can instantiate AsyncOverloadGenerator and drive it directly. -->
  <ItemGroup>
    <ProjectReference Include="..\Aigamo.Results.SourceGeneration\Aigamo.Results.SourceGeneration.csproj"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
