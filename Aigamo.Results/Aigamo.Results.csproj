<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<PackageProjectUrl>https://github.com/ycanardeau/Results</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ycanardeau/Results</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
		<!-- The generator runs on this library's own source; its output is compiled into Aigamo.Results.dll.
         PrivateAssets="all" keeps it out of the produced package as a NuGet dependency. -->
		<ProjectReference
			Include="..\Aigamo.Results.SourceGeneration\Aigamo.Results.SourceGeneration.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>

	<!-- Ship the conversion-style analyzer and its code fix to consumers, in the package's
	     analyzers/dotnet/cs folder. ReferenceOutputAssembly="false" only orders the build;
	     these are tools, not compile/runtime dependencies of the library. -->
	<ItemGroup>
		<ProjectReference
			Include="..\Aigamo.Results.Analyzers\Aigamo.Results.Analyzers.csproj"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
		<ProjectReference
			Include="..\Aigamo.Results.CodeFixes\Aigamo.Results.CodeFixes.csproj"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>

	<ItemGroup>
		<None
			Include="..\Aigamo.Results.Analyzers\bin\$(Configuration)\netstandard2.0\Aigamo.Results.Analyzers.dll"
			Pack="true"
			PackagePath="analyzers/dotnet/cs"
			Visible="false"
		/>
		<None
			Include="..\Aigamo.Results.CodeFixes\bin\$(Configuration)\netstandard2.0\Aigamo.Results.CodeFixes.dll"
			Pack="true"
			PackagePath="analyzers/dotnet/cs"
			Visible="false"
		/>
	</ItemGroup>
</Project>
